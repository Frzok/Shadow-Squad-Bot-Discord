DISCORD_BOT_TOKEN=

# Никогда не добавляйте реальные токены и секреты в Git.
# Создайте OAuth-клиент на https://develop.battle.net/access/clients
BLIZZARD_CLIENT_ID=
BLIZZARD_CLIENT_SECRET=
BLIZZARD_REGION=eu
BLIZZARD_LOCALE=ru_RU
BLIZZARD_REALM_SLUG=
BLIZZARD_GUILD_SLUG=

# API-ключ команды WoW Audit. Получается администратором команды.
WOWAUDIT_API_KEY=

# OAuth-клиент Warcraft Logs: https://www.warcraftlogs.com/api/clients/
# Автоотчёт работает только для публичных логов гильдии.
WARCRAFTLOGS_CLIENT_ID=
WARCRAFTLOGS_CLIENT_SECRET=
WARCRAFTLOGS_GUILD_NAME=Shadow Squad
WARCRAFTLOGS_SERVER_SLUG=silvermoon
WARCRAFTLOGS_REGION=EU
# По умолчанию используется канал истории лута.
WARCRAFTLOGS_REPORT_CHANNEL_ID=723427989521432628

# Канал системных предупреждений с упоминанием frzok.
HEALTH_ALERT_CHANNEL_ID=723427989521432628

# Необязательно. Путь к SQLite-базе относительно каталога проекта.
STATE_DB_PATH=bot_state.sqlite3

# Необязательно. Явная связь Discord ID с одним или несколькими персонажами.
# Привязки, созданные командой /link, хранятся в SQLite.
# DISCORD_CHARACTER_LINKS={"123456789012345678":["Main","Alt"]}

FRZOK_USER_ID=197371266007564289
PIDOR_CHANNEL_ID=810474409755541524

# Discord ID участников, которые отказались от развлекательного выбора дня.
# Несколько ID разделяются запятыми.
PIDOR_EXCLUDED_USER_IDS=
