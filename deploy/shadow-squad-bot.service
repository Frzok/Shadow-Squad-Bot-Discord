[Unit]
Description=Shadow Squad Discord Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=shadowbot
Group=shadowbot
WorkingDirectory=/opt/shadow-squad-bot
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=STATE_DB_PATH=/var/lib/shadow-squad-bot/bot_state.sqlite3
ExecStart=/opt/shadow-squad-bot/.venv/bin/python /opt/shadow-squad-bot/bot.py
Restart=on-failure
RestartSec=10
KillSignal=SIGINT
TimeoutStopSec=30
UMask=0077

NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectControlGroups=true
ProtectHome=true
ProtectHostname=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
ReadWritePaths=/var/lib/shadow-squad-bot /opt/shadow-squad-bot/backups
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictRealtime=true

[Install]
WantedBy=multi-user.target
